# Porta da API
PORT=8000
# Caminho do arquivo SQLite (relativo a backend/)
DATABASE_PATH=data/trilha.sqlite
# Fuso usado para streak, meta semanal e revisões
APP_TIMEZONE=America/Sao_Paulo
# Meta semanal padrão de sessões de estudo
WEEKLY_GOAL=5
# Origem permitida no CORS (frontend em dev)
CORS_ORIGIN=http://localhost:5173
# Opcional: se definido, a API exige login ("Authorization: Bearer <token>"; token via POST /api/v1/auth/login)
# AUTH_PASSWORD=
# Opcional: segredo de assinatura dos tokens (padrão: derivado da senha)
# AUTH_SECRET=
