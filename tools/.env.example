# Usado só pelos comandos de banco (npm run db:setup / db:migrate / db:seed).
# Supabase: botão "Connect" do projeto -> "Session pooler" (funciona em redes só IPv4).
# Troque [YOUR-PASSWORD] pela senha do banco (use %40 para @, %23 para #, etc.).
# NUNCA coloque esta URL no front-end nem no repositório: ela dá acesso total ao banco.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:[YOUR-PASSWORD]@aws-0-REGIAO.pooler.supabase.com:5432/postgres
