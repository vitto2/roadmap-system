# Projeto Supabase (Project Settings -> API). A chave anon/publishable é PÚBLICA por design:
# quem protege os dados é o login (Supabase Auth) + RLS no banco. NUNCA coloque aqui a service_role
# nem a senha/URL do banco.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Depois de criar sua conta, esconda "Criar conta" na tela de login (e desative cadastros no painel do Supabase):
# VITE_ALLOW_SIGNUP=false
